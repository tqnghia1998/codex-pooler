POOL_PORT=3010
POOL_BIND_HOST=127.0.0.1
POOL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POOL_ALLOWED_ORIGINS=
POOL_FIREWALL_ALLOWLIST=
POOL_TRUSTED_PROXIES=
POOL_COOKIE_SECURE=false
# Public path when QuotaHub is mounted below a domain root, for example /quotahub.
POOL_PUBLIC_BASE_PATH=
POOL_CODEX_CLI=codex
# Defaults to node/pool/.data when omitted.
# It must not point to Relaydeck's node/.data.
POOL_DATA_DIR=
# Defaults to 5 minutes when omitted. Refreshes Codex sharing quota only.
POOL_QUOTA_REFRESH_INTERVAL_MS=
# Optional delayed Claude/AIS quota observations from https://loop.shopee.io.
# The service token is server-only. Loop's provider-reported balance is used
# when available; otherwise QuotaHub falls back to monthly cap minus usage.
POOL_AI_QUOTA_SERVICE_TOKEN=
# Source data is approximately one hour behind. Refreshes hourly by default.
POOL_AI_QUOTA_DELAY_MS=3600000
POOL_AI_QUOTA_REFRESH_INTERVAL_MS=3600000
POOL_AI_QUOTA_TIMEOUT_MS=30000
# Defaults to one hour when omitted.
POOL_TOKEN_REFRESH_INTERVAL_MS=
# SMTP is optional. When omitted, email notifications are skipped.
POOL_SMTP_HOST=
POOL_SMTP_PORT=587
POOL_SMTP_SECURE=false
POOL_SMTP_USER=
POOL_SMTP_PASS=
POOL_SMTP_FROM=
# Defaults to 15 seconds when omitted.
POOL_EMAIL_DELIVERY_INTERVAL_MS=
# Defaults to 6 hours when omitted.
POOL_PRODUCT_CLEANUP_INTERVAL_MS=
# Defaults to 60 minutes when omitted. Keeps one full QuotaHub snapshot on disk.
POOL_BACKUP_INTERVAL_MS=
# Claude request-shaping controls, as a bounded JSON object. Does not affect sharing quota policy.
POOL_CLAUDE_CONFIG_JSON=
# Shared Codex origin circuit-breaker controls.
POOL_CODEX_HOST_CIRCUIT_ENABLED=true
POOL_CODEX_HOST_FAILURE_THRESHOLD=
POOL_CODEX_HOST_FAILURE_WINDOW_MS=
POOL_CODEX_HOST_COOLDOWN_MS=
POOL_CODEX_HOST_MAX_ENTRIES=
# Codex Responses WebSocket transport controls.
POOL_CODEX_WEBSOCKET_KEEPALIVE_MS=30000
POOL_CODEX_WEBSOCKET_IDLE_MS=1800000
POOL_CODEX_WEBSOCKET_FRAME_BYTES=16777216
POOL_CODEX_WEBSOCKET_PENDING_BYTES=2097152
POOL_CODEX_WEBSOCKET_BACKPRESSURE_BYTES=16777216
# Retry before downstream SSE headers are committed when Codex overloads after handshake.
POOL_CODEX_STREAM_BOOTSTRAP_BUFFERING=false
POOL_CODEX_STREAM_BOOTSTRAP_BYTES=524288
POOL_CODEX_STREAM_BOOTSTRAP_EVENTS=32
POOL_CODEX_STREAM_BOOTSTRAP_TIMEOUT_MS=1000
# Protocol rewrites are disabled unless explicitly enabled and the caller is official Codex.
POOL_CODEX_OPTIMIZE_MULTI_AGENT_V2=false
POOL_CODEX_ORPHAN_DELEGATION_COMPATIBILITY=false
