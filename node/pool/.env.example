POOL_PORT=3010
POOL_BIND_HOST=127.0.0.1
POOL_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POOL_ALLOWED_ORIGINS=
POOL_FIREWALL_ALLOWLIST=
POOL_TRUSTED_PROXIES=
POOL_COOKIE_SECURE=false
# Public path when Codex Share is mounted below a domain root, for example /codex-share.
POOL_PUBLIC_BASE_PATH=
POOL_CODEX_CLI=codex
# Defaults to node/pool/.data when omitted.
# It must not point to Relaydeck's node/.data.
POOL_DATA_DIR=
# Optional durable Redis record store. When set, POOL_DATA_DIR is not used.
POOL_REDIS_URL=
# Defaults to codex-share. Use a distinct prefix for each environment.
POOL_REDIS_PREFIX=
# Defaults to 60 seconds when omitted.
POOL_QUOTA_REFRESH_INTERVAL_MS=
# Defaults to one hour when omitted.
POOL_TOKEN_REFRESH_INTERVAL_MS=
# SMTP is optional. When omitted, email notifications are skipped.
POOL_SMTP_HOST=
POOL_SMTP_PORT=587
POOL_SMTP_SECURE=false
POOL_SMTP_USER=
POOL_SMTP_PASS=
POOL_SMTP_FROM=
# Defaults to 15 seconds when omitted.
POOL_EMAIL_DELIVERY_INTERVAL_MS=
# Defaults to 6 hours when omitted.
POOL_PRODUCT_CLEANUP_INTERVAL_MS=
