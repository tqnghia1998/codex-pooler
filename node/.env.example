CODEX_POOLER_COMPASS_GATEWAY_TOKEN=
CODEX_POOLER_API_KEY=replace-with-a-client-key
# Codex Responses WebSocket transport controls.
CODEX_POOLER_CODEX_WEBSOCKET_KEEPALIVE_MS=30000
CODEX_POOLER_CODEX_WEBSOCKET_IDLE_MS=1800000
CODEX_POOLER_CODEX_WEBSOCKET_FRAME_BYTES=16777216
CODEX_POOLER_CODEX_WEBSOCKET_PENDING_BYTES=2097152
CODEX_POOLER_CODEX_WEBSOCKET_BACKPRESSURE_BYTES=16777216
# Retry before downstream SSE headers are committed when Codex overloads after handshake.
CODEX_POOLER_CODEX_STREAM_BOOTSTRAP_BUFFERING=false
CODEX_POOLER_CODEX_STREAM_BOOTSTRAP_BYTES=524288
CODEX_POOLER_CODEX_STREAM_BOOTSTRAP_EVENTS=32
CODEX_POOLER_CODEX_STREAM_BOOTSTRAP_TIMEOUT_MS=1000
# Protocol rewrites are disabled unless explicitly enabled and the caller is official Codex.
CODEX_POOLER_CODEX_OPTIMIZE_MULTI_AGENT_V2=false
CODEX_POOLER_CODEX_ORPHAN_DELEGATION_COMPATIBILITY=false
